# Database Configuration for FiveM
# MySQL is the default database for FiveM servers

# Database URL for MySQL
# Format: mysql://username:password@host:port/database_name
DATABASE_URL="mysql://root:password@localhost:3306/fivem_database"

# Alternative configuration using individual variables (if needed)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=password
# DB_NAME=fivem_database

# FiveM specific database settings
# These are commonly used settings for FiveM MySQL databases
DB_CHARSET=utf8mb4
DB_COLLATE=utf8mb4_unicode_ci

# Connection pool settings (optional)
# DB_POOL_MIN=2
# DB_POOL_MAX=10
# DB_POOL_IDLE_TIMEOUT=30000